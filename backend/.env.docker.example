# Docker environment configuration example
# Copy this to src/.env and update with your actual values

# Django settings
DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=*

# Database configuration
# Set to True for SQLite (development), False for Supabase Postgres
DB_USE_SQLITE=False

# Supabase Postgres connection (required when DB_USE_SQLITE=False)
# Get this from Supabase Dashboard -> Settings -> Database -> Connection String
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase API keys (optional - only needed for Auth/Storage/Realtime features)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Email domain restriction
ALLOWED_EMAIL_DOMAIN=@iitrpr.ac.in

# JWT token lifetimes (in minutes for access, days for refresh)
JWT_ACCESS_LIFETIME=15
JWT_REFRESH_LIFETIME=7

# Google OAuth (optional - for future Google Sign-In implementation)
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id
GOOGLE_CLIENT_ID_WEB=your-web-client-id
GOOGLE_CLIENT_SECRET_WEB=your-web-client-secret
